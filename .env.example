# Copy to .env locally. Never commit real values.
PORT=3001
PUBLIC_APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Cloud mode requires PostgreSQL/Tiger Data URL. No insecure TLS overrides.
DATABASE_URL=
# Alternatively use PostgreSQL host fields from the Tiger Data credentials file.
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGSSLMODE=verify-full
# Explicit local embedded PostgreSQL for development; not Tiger Data.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.data/postgres
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Legacy PHOTON_PROJECT_ID / PHOTON_PROJECT_SECRET remain supported.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_STORAGE=local
PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
LOCAL_UPLOAD_PATH=uploads
# Random long secrets for independent moderation and trusted worker API access.
MODERATOR_TOKEN=
WORKER_TOKEN=
# Demo seeding is never automatic.
