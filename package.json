{
  "name": "draindispatch",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server",
    "test:browser": "playwright test",
    "start": "npm run start -w server",
    "worker": "npm run worker -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@opentelemetry/core": "2.12.0"
  }
}
